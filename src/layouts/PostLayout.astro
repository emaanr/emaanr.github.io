---
import { render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import BreadcrumbsLayout from "./BreadcrumbsLayout.astro";
import Metadata from "@components/ui/Metadata.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"readBlog"> | CollectionEntry<"readNotes"> | CollectionEntry<"execProjects">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const currentCrumb = post.data.title;
const groupCrumb = "group" in post.data ? post.data.group : undefined;
---

<Layout>
  <article id="post">
    <BreadcrumbsLayout currentCrumb={currentCrumb} groupCrumb={groupCrumb}>
      <div class="markdown">
        <Metadata updated={post.data.updated} created={post.data.created} tags={post.data.tags} />
        <Content />
      </div>
    </BreadcrumbsLayout>
  </article>
</Layout>
