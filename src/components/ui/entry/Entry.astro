---
interface Props {
  variant: "post" | "exec" | "thought" | "group";
  href?: string;
}

const { variant, href } = Astro.props;

// Map variants to class combinations
const variantClasses: Record<Props["variant"], string[]> = {
  post: ["post", "entry--accent", "entry--accent-primary", "entry--hover", "entry--bordered", "entry--clickable"],
  exec: ["exec", "entry--hover", "entry--bordered"],
  thought: ["thought", "entry--accent", "entry--accent-primary", "entry--hover", "entry--bordered"],
  group: ["group", "entry--accent", "entry--accent-primary", "entry--hover", "entry--bordered", "entry--clickable", "entry--chevron"],
};

const classes = ["entry", ...variantClasses[variant]].join(" ");

const Element = href ? "a" : variant === "group" ? "summary" : "div";
---

<Element class={classes} href={href}>
  <slot />
</Element>

<style>
  .post,
  .group {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
  }

  .exec {
    padding-bottom: 0.5rem;
  }

  .thought {
    span {
      font-size: 0.75rem;
      color: var(--slate-200);
    }
  }
</style>
