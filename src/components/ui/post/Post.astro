---
import { formatDate } from "@utils/date.ts";
import { truncateTags } from "@utils/tags.ts";
import Entry from "@components/ui/entry/Entry.astro";
import Tags from "@components/ui/tags/Tags.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"readBlog"> | CollectionEntry<"readNotes">;
  path: "blog" | "notes";
}

const { post, path } = Astro.props;
---

<Entry variant="post" href={`/read/${path}/${post.id}`}>
  <div class="lhs">
    <p>{post.data.title}</p>
    <div class="lg">
      <Tags tags={truncateTags(post.data.tags, 6)} />
    </div>
    <div class="md">
      <Tags tags={truncateTags(post.data.tags, 3)} />
    </div>
    <div class="sm">
      <Tags tags={truncateTags(post.data.tags, 2)} />
    </div>
  </div>
  <span>{formatDate(post.data.updated)}</span>
</Entry>

<style>
  .lhs {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
  }

  /* Large */
  .lg {
    display: contents;
  }
  .md {
    display: none;
  }
  .sm {
    display: none;
  }

  /* Medium */
  @media (max-width: 500px) {
    .lg {
      display: none;
    }
    .md {
      display: contents;
    }
    .sm {
      display: none;
    }
  }

  /* Small */
  @media (max-width: 450px) {
    .lg {
      display: none;
    }
    .md {
      display: none;
    }
    .sm {
      display: contents;
    }
  }

  /* Extra Small */
  @media (max-width: 400px) {
    .lg {
      display: none;
    }
    .md {
      display: none;
    }
    .sm {
      display: none;
    }
  }
</style>
